{
  "name": "thinking-slider",
  "description": "Thinking-strength slider: replaces the composer model seat's reasoning-effort button list with a snap-to-step slider for the DSH web UI.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Motuo24/dsh-thinking-slider.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js"
  ]
}
